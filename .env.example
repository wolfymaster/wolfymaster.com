# Server-side environment variables (not exposed to browser)

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.mailgun.org

# Recipient email for quote requests
RECIPIENT_EMAIL=wolfy@wolfymaster.com

# Nonce secret for form protection (server-side validation)
# Generate with: openssl rand -hex 32
NONCE_SECRET=your-secret-key-here

# Twitch API Configuration
# Get credentials from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
# Your Twitch user ID (numeric). Find it at https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=your-twitch-user-id

# Client-side environment variables (exposed to browser, prefixed with PUBLIC_)

# Nonce secret for form submission (must match NONCE_SECRET above)
PUBLIC_NONCE_SECRET=your-secret-key-here
